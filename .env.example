# Copy to .env and fill in. .env is git-ignored. Without a key everything runs in mock mode.
ANTHROPIC_API_KEY=

# mock (default, no API calls) | replay (recorded cassettes) | live (real Claude calls, capped)
# PULSE_LLM=mock
# PULSE_RUN_CAP_USD=0.60        # cap per agent run
# PULSE_TOTAL_CAP_USD=12        # cumulative cap, tracked in <state>/spend.json

# Optional overrides
# PULSE_MODEL_ORCHESTRATOR=claude-opus-5-5
# PULSE_STATE=.pulse            # state dir the loop writes and the UI reads
# PULSE_DATA=data/eye           # simulator output
# PULSE_INBOX=.pulse/inbox      # drop new metric definitions here
