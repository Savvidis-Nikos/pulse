.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
*.zip

# generated by the simulator (python -m marketplace.run rebuilds it, seeded, ~1 min)
data/

# runtime state of a Pulse run (python -m pulse reset)
.pulse/
.pulse_live/

# learned graph base read by the argus library (added metrics, aliases, learned edges).
# Pulse was built and scored with these 4 files present: keep them, ignore anything else argus writes here.
.argus/*
!.argus/added_metrics.yaml
!.argus/aliases.json
!.argus/learned_identities.json
!.argus/learned_causes.json
